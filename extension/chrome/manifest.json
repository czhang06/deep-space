{
  "manifest_version": 3,
  "name": "Tiny Kingdom Browser Tracker",
  "version": "0.1.0",
  "description": "Sends active browser tab categories to Tiny Kingdom on localhost.",
  "permissions": ["tabs", "storage", "windows", "alarms"],
  "host_permissions": ["http://127.0.0.1:38471/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Tiny Kingdom Tracker"
  }
}
